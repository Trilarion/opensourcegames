{% extends "base.jinja" %}
{% block content %}
  <div class="container">
    <div class="box"><p class="title is-4">{{ listing['title'] }}</p></div>
                    {#- iterate over items, each one as a box with the name and the contacts in one line #}
{% for item in listing['items'] %}
<div id="{{ item['anchor-id'] }}" class="box"><p class="title is-5 mb-2"><bdi>{{ item['name'] }}</bdi>{% for contact in item['contact'] %} {{ macros.render_element(contact) }}{% endfor %}</p>
{{ macros.render_element(item['games']) }}{% if 'organization' in item %}<br>{{ macros.render_element(item['organization']) }}{% endif %}</div>
{%- endfor %}
                    {#- improve link and back to top, once per page #}
  <p class="is-size-7 has-text-right"><a href="{{ base['url_to'](['contribute.html#developers']) }}" title="Contribution guide" class="mr-2">Improve</a><a href="#">Back to top</a></p>
  </div>
{% endblock %}
